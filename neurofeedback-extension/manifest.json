{
  "manifest_version": 3,
  "name": "NeuroFeedback.OS Sensor",
  "version": "1.0",
  "description": "Telemetry sensor for NeuroFeedback.OS. Tracks cognitive load metrics without recording content.",
  "permissions": [
    "tabs",
    "idle",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NeuroFeedback Sensor"
  }
}
